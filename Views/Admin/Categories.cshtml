@model DnTech_Ecommerce.ViewModels.AdminCategoriesViewModel
@{
    ViewData["Title"] = "Gestión de Categorías";
    Layout = "_AdminLayout";
}

<!-- Encabezado con botón crear -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Gestión de Categorías</h4>
    <button type="button" class="btn btn-admin-primary" data-bs-toggle="modal" data-bs-target="#createModal">
        <i class="bi bi-plus-lg me-1"></i> Crear Categoría
    </button>
</div>

<!-- Estadísticas rápidas -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-primary me-3" style="width: 40px; height: 40px; font-size: 1.2rem;">
                    <i class="bi bi-tags"></i>
                </div>
                <div>
                    <div class="stat-value" style="font-size: 1.5rem;">@Model.TotalCategories</div>
                    <div class="stat-label" style="font-size: 0.75rem;">Total</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-success me-3" style="width: 40px; height: 40px; font-size: 1.2rem;">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <div class="stat-value" style="font-size: 1.5rem;">@Model.ActiveCategories</div>
                    <div class="stat-label" style="font-size: 0.75rem;">Activas</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-secondary me-3" style="width: 40px; height: 40px; font-size: 1.2rem;">
                    <i class="bi bi-x-circle"></i>
                </div>
                <div>
                    <div class="stat-value" style="font-size: 1.5rem;">@Model.InactiveCategories</div>
                    <div class="stat-label" style="font-size: 0.75rem;">Inactivas</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de categorías -->
<div class="admin-table">
    <div class="p-3 border-bottom">
        <h5 class="mb-0">
            <i class="bi bi-tags me-2"></i>
            Categorías (@Model.TotalCategories)
        </h5>
    </div>

    @if (Model.Categories.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Slug</th>
                        <th>Productos</th>
                        <th>Estado</th>
                        <th>Fecha Creación</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model.Categories)
                    {
                        <tr class="@(!category.IsActive ? "table-secondary" : "")">
                            <td><strong>@category.Id</strong></td>
                            <td><strong>@category.Name</strong></td>
                            <td>
                                @if (!string.IsNullOrEmpty(category.Description))
                                {
                                    if (category.Description.Length > 50)
                                    {
                                        <span>@category.Description.Substring(0, 50)...</span>
                                    }
                                    else
                                    {
                                        <span>@category.Description</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(category.Slug))
                                {
                                    <code>@category.Slug</code>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (category.ProductCount > 0)
                                {
                                    <span class="badge bg-info">@category.ProductCount</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">0</span>
                                }
                            </td>
                            <td>
                                @if (category.IsActive)
                                {
                                    <span class="badge bg-success">Activa</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactiva</span>
                                }
                            </td>
                            <td>
                                <div>@category.CreatedAt.ToString("dd/MM/yyyy")</div>
                                <small class="text-muted">@category.CreatedAt.ToString("HH:mm")</small>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-primary"
                                            data-bs-toggle="modal" data-bs-target="#editModal@(category.Id)"
                                            title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <form asp-action="ToggleCategoryStatus" asp-route-id="@category.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-@(category.IsActive ? "warning" : "success")"
                                                title="@(category.IsActive ? "Desactivar" : "Activar")">
                                            <i class="bi bi-@(category.IsActive ? "eye-slash" : "eye")"></i>
                                        </button>
                                    </form>

                                    @if (category.ProductCount == 0)
                                    {
                                        <button type="button" class="btn btn-outline-danger"
                                                data-bs-toggle="modal" data-bs-target="#deleteModal@(category.Id)"
                                                title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>

                                <!-- Modal Editar -->
                                <div class="modal fade" id="editModal@(category.Id)" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form asp-action="EditCategory" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="Id" value="@category.Id" />

                                                <div class="modal-header">
                                                    <h5 class="modal-title">Editar Categoría</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label class="form-label">Nombre *</label>
                                                        <input type="text" class="form-control" name="Name" value="@category.Name" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label">Descripción</label>
                                                        <textarea class="form-control" name="Description" rows="3">@category.Description</textarea>
                                                    </div>
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input" type="checkbox" name="IsActive" 
                                                               value="true" checked="@category.IsActive" />
                                                        <label class="form-check-label">Activa</label>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                    <button type="submit" class="btn btn-admin-primary">Guardar Cambios</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <!-- Modal Eliminar -->
                                <div class="modal fade" id="deleteModal@(category.Id)" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Confirmar Eliminación</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p>¿Estás seguro de que deseas eliminar la categoría?</p>
                                                <p><strong>@category.Name</strong></p>
                                                <p class="text-danger">Esta acción no se puede deshacer.</p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <form asp-action="DeleteCategory" asp-route-id="@category.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger">Eliminar</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="p-5 text-center text-muted">
            <i class="bi bi-inbox display-3"></i>
            <p class="mt-3">No hay categorías creadas</p>
            <button type="button" class="btn btn-admin-primary mt-2" data-bs-toggle="modal" data-bs-target="#createModal">
                <i class="bi bi-plus-lg me-1"></i>Crear Primera Categoría
            </button>
        </div>
    }
</div>

<!-- Modal Crear Categoría -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateCategory" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-plus-circle me-2"></i>Crear Nueva Categoría
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre *</label>
                        <input type="text" class="form-control" name="Name" required 
                               placeholder="Ej: Laptops, Smartphones, Accesorios" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea class="form-control" name="Description" rows="3"
                                  placeholder="Descripción breve de la categoría (opcional)"></textarea>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked />
                        <label class="form-check-label">Activa</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-admin-primary">
                        <i class="bi bi-check-lg me-1"></i>Crear Categoría
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
